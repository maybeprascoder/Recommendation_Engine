{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unihive.local/schemas/qualitative_mappings.schema.json",
  "title": "Human-approved qualitative evidence mappings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mappings"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "claim_category", "rubric_sha256", "judgment_requirements",
          "evidence_rule_id", "quality_label", "depth_label", "validated_by",
          "validated_on", "source"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim_category": {
            "enum": ["project", "work", "research", "publication", "coursework", "education", "activity", "other"]
          },
          "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "judgment_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "labels"],
              "properties": {
                "dimension": {"type": "string", "minLength": 1},
                "labels": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "not": {"const": "unknown"}}
                }
              }
            }
          },
          "evidence_rule_id": {"type": "string", "minLength": 1},
          "quality_label": {"type": "string", "minLength": 1},
          "depth_label": {"type": "string", "minLength": 1},
          "validated_by": {"type": "string", "minLength": 1},
          "validated_on": {"type": "string", "format": "date"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
