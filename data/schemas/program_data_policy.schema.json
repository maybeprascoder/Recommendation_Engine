{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unihive.local/schemas/program_data_policy.schema.json",
  "title": "UniHive program-data policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximum_age_days",
    "provisional",
    "validated_by",
    "source"
  ],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "maximum_age_days": {"type": "integer", "minimum": 1},
    "provisional": {"type": "boolean"},
    "validated_by": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]}
  }
}
