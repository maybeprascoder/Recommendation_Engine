{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unihive.local/schemas/questions.schema.json",
  "title": "UniHive progressive question bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provisional",
    "validated_by",
    "source",
    "questions"
  ],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "provisional": {"type": "boolean"},
    "validated_by": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "resolves_type", "resolves_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "resolves_type": {"enum": ["COMPETENCY", "FIELD"]},
          "resolves_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
